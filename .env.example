DB_HOST=localhost
DB_PORT=5432
DB_USER=safeexec
DB_PASSWORD=safeexec_secret
DB_NAME=safeexec_ledger

# FastAPI Trusted Control Plane
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=*
LOG_LEVEL=INFO

