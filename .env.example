
# ==========================================
# SafeExec AI Configuration
# ==========================================

# Celesto Cloud API
CELESTO_API_KEY=your_celesto_api_key_here

# ==========================================
# Google Gemini API Configuration
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# ==========================================
# PostgreSQL Ledger Database
# ==========================================

DATABASE_URL=postgresql://safeexec:safeexec_secret@localhost:5432/safeexec_ledger

DB_HOST=localhost
DB_PORT=5432
DB_USER=safeexec
DB_PASSWORD=safeexec_secret
DB_NAME=safeexec_ledger

# ==========================================
# FastAPI Trusted Control Plane
# ==========================================

PORT=8080
HOST=0.0.0.0

CORS_ORIGINS=*
LOG_LEVEL=INFO
